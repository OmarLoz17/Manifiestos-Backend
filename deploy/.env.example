# Copiar a .env (ignorado por Git). Aquí solo van valores NO secretos; los secretos viven en deploy/secretos/.
PROYECTO=manifiestos
VERSION=local
# Client ID OAuth «Aplicación web» (público). En el ensayo basta un valor ficticio de 10+ caracteres.
GOOGLE_CLIENT_ID=ensayo-ficticio.apps.googleusercontent.com
# Organización única de la instalación. La demo ficticia usa de000000-0000-4000-8000-000000000001.
ORGANIZACION_ID=de000000-0000-4000-8000-000000000001
# Drive (vacío = los archivos se quedan en el volumen del VPS). Para activarlo, el JSON de la cuenta de servicio debe estar
# montado dentro del contenedor (p. ej. /run/secrets/...) y la unidad compartida creada.
DRIVE_CREDENCIALES_RUTA=
DRIVE_UNIDAD_ID=
DRIVE_CARPETA_RAIZ=
# Avisos push: en el VPS se activan con compose.push.yaml (monta secretos/fcm-servicio.json); esta variable solo sirve fuera de Docker.
PUSH_CREDENCIALES_RUTA=
# Retención local de evidencias ya archivadas en Drive. 0 = el VPS conserva todo. Con Drive validado y 50-100 usuarios: 30.
ARCHIVOS_RETENCION_DIAS=0
# Dominios aceptados por la API, separados por «;». Con el túnel: manifiestos.armultiservicios.mx;localhost;127.0.0.1 (localhost/127.0.0.1 son el healthcheck y el ensayo por túnel SSH). «*» = sin restricción.
HOSTS_PERMITIDOS=*
